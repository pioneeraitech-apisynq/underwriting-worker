# Kafka — the stream of new policy applications this worker consumes
KAFKA_BROKERS=kafka-1.digitalinsurance.dev:9092,kafka-2.digitalinsurance.dev:9092
KAFKA_CLIENT_ID=underwriting-worker
KAFKA_GROUP_ID=underwriting-worker
KAFKA_APPLICATIONS_TOPIC=insurance.policy-applications.v1
KAFKA_SASL_USERNAME=underwriting-worker
KAFKA_SASL_PASSWORD=replace-me

# Postgres — where underwriting decisions are written
POSTGRES_URL=postgres://underwriting:replace-me@postgres.digitalinsurance.dev:5432/underwriting

# Redis — caches downstream lookups and de-duplicates redelivered applications
REDIS_URL=redis://cache.digitalinsurance.dev:6379/3

# Internal HTTP dependencies
POLICY_API_URL=https://policy.digitalinsurance.dev
CLAIMS_API_URL=https://claims.digitalinsurance.dev

# AWS Bedrock — risk scoring agent (us.anthropic.claude-3-5-sonnet-20241022-v2:0)
# The us. prefix selects the cross-region inference profile for automatic
# regional failover during peak utilisation bursts.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# Bedrock Guardrail applied to every risk-scoring inference call.
# BEDROCK_GUARDRAIL_ID is required — the worker will not start without it.
# BEDROCK_GUARDRAIL_VERSION defaults to DRAFT if omitted; set to the numeric
# version (e.g. 1) in production once the guardrail has been published.
# The worker's IAM execution role must also carry the condition key
#   bedrock:GuardrailIdentifier = <BEDROCK_GUARDRAIL_ID>
# so that guardrail use is enforced at the policy level even if application
# code changes.
BEDROCK_GUARDRAIL_ID=replace-me
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Google Gemini — decision letter drafting agent (gemini-2.0-flash)
GOOGLE_API_KEY=replace-me

# SendGrid — delivery of decision letters
SENDGRID_API_KEY=replace-me
DECISION_LETTER_FROM_EMAIL=underwriting@digitalinsurance.dev
DECISION_LETTER_REPLY_TO=support@digitalinsurance.dev
