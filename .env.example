# Kafka — the stream of new policy applications this worker consumes
KAFKA_BROKERS=kafka-1.digitalinsurance.dev:9092,kafka-2.digitalinsurance.dev:9092
KAFKA_CLIENT_ID=underwriting-worker
KAFKA_GROUP_ID=underwriting-worker
KAFKA_APPLICATIONS_TOPIC=insurance.policy-applications.v1
KAFKA_SASL_USERNAME=underwriting-worker
KAFKA_SASL_PASSWORD=replace-me

# Postgres — where underwriting decisions are written
POSTGRES_URL=postgres://underwriting:replace-me@postgres.digitalinsurance.dev:5432/underwriting

# Redis — caches downstream lookups and de-duplicates redelivered applications
REDIS_URL=redis://cache.digitalinsurance.dev:6379/3

# Internal HTTP dependencies
POLICY_API_URL=https://policy.digitalinsurance.dev
CLAIMS_API_URL=https://claims.digitalinsurance.dev

# AWS Bedrock — risk scoring agent (anthropic.claude-3-5-sonnet-20241022-v2:0)
#
# Authentication — use an IAM role, NOT static access keys.
#   • Local dev  : configure an AWS CLI profile and set AWS_PROFILE below, or
#                  rely on ~/.aws/credentials with a role that has
#                  bedrock:InvokeModel on the target model ARN.
#   • ECS        : attach a task role with bedrock:InvokeModel; the SDK picks
#                  it up automatically via the ECS container credentials endpoint.
#   • Kubernetes : use IRSA (IAM Roles for Service Accounts) and annotate the
#                  pod's ServiceAccount; no environment variables are needed.
#   • EC2        : attach an instance profile; again, no extra variables needed.
#
# DO NOT set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY for this service.
# Long-lived static keys are a credential-exposure risk for a worker that
# processes applicant PII and full claims history.  The AWS SDK resolves
# credentials automatically through the default provider chain (environment →
# ~/.aws → container endpoint → instance metadata), which always yields
# short-term, automatically-rotated tokens when a role is used.
#
# Cost allocation — tag the IAM role that this service assumes so that Bedrock
# inference costs are visible per team and product line in AWS Cost Explorer:
#
#   aws iam tag-role \
#     --role-name underwriting-worker-bedrock \
#     --tags Key=project,Value=underwriting-worker Key=team,Value=platform
#
# Then activate "project" and "team" as cost allocation tag keys in the
# AWS Billing console (Cost Allocation Tags → Activate) so they appear in
# Cost Explorer and CUR 2.0 reports.
#
AWS_REGION=us-east-1
# AWS_PROFILE=underwriting-dev   # uncomment for local dev with a named profile

# Google Gemini — decision letter drafting agent (gemini-2.0-flash)
GOOGLE_API_KEY=replace-me

# SendGrid — delivery of decision letters
SENDGRID_API_KEY=replace-me
DECISION_LETTER_FROM_EMAIL=underwriting@digitalinsurance.dev
DECISION_LETTER_REPLY_TO=support@digitalinsurance.dev
