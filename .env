# Demo values only. Every host below is fictional and every secret is a
# placeholder — nothing here reaches a real system.
KAFKA_BROKERS=kafka-1.digitalinsurance.dev:9092,kafka-2.digitalinsurance.dev:9092
KAFKA_CLIENT_ID=underwriting-worker
KAFKA_GROUP_ID=underwriting-worker
KAFKA_APPLICATIONS_TOPIC=insurance.policy-applications.v1
KAFKA_SASL_USERNAME=underwriting-worker
KAFKA_SASL_PASSWORD=PLACEHOLDER_KAFKA_PASSWORD

POSTGRES_URL=postgres://underwriting:PLACEHOLDER_PG_PASSWORD@postgres.digitalinsurance.dev:5432/underwriting

REDIS_URL=redis://cache.digitalinsurance.dev:6379/3

POLICY_API_URL=https://policy.digitalinsurance.dev
CLAIMS_API_URL=https://claims.digitalinsurance.dev

# AWS credentials are intentionally absent. The worker must run under an IAM
# role (EC2 instance profile or ECS task role) so that the AWS SDK resolves
# short-lived credentials via the default credential provider chain. Do not
# add AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here or in any deployment
# configuration — static long-lived key pairs are not permitted for this service.
AWS_REGION=us-east-1

BEDROCK_GUARDRAIL_ID=PLACEHOLDER_GUARDRAIL_ID
BEDROCK_GUARDRAIL_VERSION=1

GOOGLE_API_KEY=PLACEHOLDER_GOOGLE_API_KEY

SENDGRID_API_KEY=SG.PLACEHOLDER_SENDGRID_API_KEY
DECISION_LETTER_FROM_EMAIL=underwriting@digitalinsurance.dev
DECISION_LETTER_REPLY_TO=support@digitalinsurance.dev
